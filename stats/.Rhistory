Tipo_Trial = sample(rep(c("Repeticao", "Troca"), times = 35)),
# simula os acertos
Acerto = rbinom( # modela uma situação que só tem 2 saídas (acerto ou erro)
n(), # quantos vezes precisará gerar um resultado (número de linhas esperado)
1, # número de tentativas por trial
prob = 0.95 # probabilidade de acerto; base na experiência
),
Tipo_Anterior = lag(Tipo_Trial),
Acerto_Anterior = lag(Acerto),
# simula a mudança no RMSSD por participante
Delta_RMSSD = case_when(
Fase == "Pre_Neutro" ~ 0.0,
Fase == "Pos_Neutro" ~ efeitos_RMSSD[as.character(Sessao[1])] + Desvio_Delta_RMSSD
),
RMSSD_Fase = ifelse(Fase == "Pre_Neutro", Desvio_basal_RMSSD, Desvio_basal_RMSSD + Delta_RMSSD),
# validação e simulação do SC
SC_Valido = (Tipo_Trial == "Troca" & Acerto == 1 &
Tipo_Anterior == "Repeticao" & Acerto_Anterior == 1),
Switch_Cost = ifelse(
SC_Valido,
case_when(
# Pré: sem efeito da respiração, sem efeito do RMSSD
Fase == "Pre_Neutro" ~
rnorm(n(),
mean = 130 +
(efeito_RMSSD_sc * RMSSD_Fase) +
Desvio_basal_SC,
sd = 50), # Rogers & Monsell
# Pós: efeito direto da respiração + efeito do RMSSD
Fase == "Pos_Neutro" ~
rnorm(n(),
mean = 130 +
efeitos_sc[as.character(Sessao[1])] +
(efeito_RMSSD_sc * RMSSD_Fase) +
Desvio_basal_SC,
sd = 50)
),
NA_real_
)
) %>%
ungroup()
head(dados_brutos)
View(dados_brutos)
dados_brutos %>%
filter(SC_Valido) %>%
group_by(Sessao, Fase) %>%
summarise(
RMSSD_medio = mean(Delta_RMSSD),
SC_medio = mean(Switch_Cost),
n = n()
)
modelo_lmer <- lmer(
Switch_Cost ~ Sessao * Fase + RMSSD_Fase + (1 | ID_Participante),
data = dados_brutos %>% filter(SC_Valido)
)
summary(modelo_lmer)
# análise de poder simr ===========
# parâmetros
n_maximo <- 100
efeito <- 0.3
ICC <- 0.3
modelo_estendido <- extend(modelo_lmer, along = "ID_Participante", n = 60)
set.seed(45)
curva_poder <- powerCurve(
modelo_estendido,
test = fcompare(~ Sessao + Fase + RMSSD_Fase),
along = "ID_Participante",
breaks = seq(10, 60, by = 5),
nsim = 10
)
print(curva_poder)
warnings()
